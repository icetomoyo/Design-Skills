{
  "version": 1,
  "meta": {
    "product_type": "saas-dashboard",
    "audience": "客服团队主管与运营（B 端坐席调度，operate 意图）",
    "scenarios": ["运营总览页：当日核心指标监控 + 14 天趋势 + 未分配工单分派"]
  },
  "brand": {
    "personality": ["冷静", "高效", "可信"],
    "references": ["Linear / Stripe 式紧凑后台数据面板"]
  },
  "style": {
    "direction": "紧凑数据密集型：单一钴蓝 accent + slate 中性 ramp，层级靠字号与表面阶梯；主图为先、列表为辅，无装饰性渐变与 glow",
    "do_not": [
      "渐变文字与大面积渐变",
      "彩色 glow / 发光效果",
      "emoji 作图标",
      "问候式标题",
      "无来源的信任声明（Trusted by N+ 类）",
      "斑马纹表格",
      "假数据特征数字（99999/123456 类）"
    ]
  },
  "tokens": {
    "colors": {
      "primary": "#2563EB",
      "primary_hover": "#1D4ED8",
      "success": "#15803D",
      "danger": "#B91C1B",
      "warn": "#92400E",
      "neutrals": ["#0F172A", "#334155", "#475569", "#64748B"],
      "border": "#E2E8F0",
      "surface": "#FFFFFF",
      "surface_muted": ["#F8FAFC", "#F1F5F9"],
      "sidebar_bg": "#0F172A",
      "sidebar_text": "#CBD5E1",
      "sidebar_text_muted": "#94A3B8",
      "badge_danger_bg": "#FEF2F2",
      "badge_warn_bg": "#FFFBEB",
      "text_on_primary": "#FFFFFF"
    },
    "typography": {
      "body": "Inter, system-ui, -apple-system, Segoe UI, PingFang SC, Microsoft YaHei, sans-serif",
      "display": "Inter, system-ui, -apple-system, Segoe UI, PingFang SC, Microsoft YaHei, sans-serif",
      "scale": [12, 14, 16, 20, 24, 30]
    },
    "spacing": {
      "base": 4,
      "scale": [4, 8, 12, 16, 24, 32, 48, 64]
    },
    "radius": {
      "sm": 4,
      "md": 8,
      "lg": 12
    },
    "shadow": {
      "card": "0 1px 2px rgba(15,23,42,0.06)"
    }
  },
  "components": {
    "kpi_card": {
      "rules": [
        "同高：网格拉伸 + h-full",
        "三要素齐全：标签 + 数字 + 变化（带方向符号与 vs 昨日基准）",
        "数字用 tabular-nums"
      ]
    },
    "table": {
      "density": "compact",
      "rules": ["数字右对齐 + tabular-nums", "禁用斑马纹", "状态用点 + 文本，不只靠颜色"]
    },
    "chart": {
      "rules": [
        "趋势用折线；系列 <=2；实线/虚线区分 + 线端直接标签",
        "面积填充 15% 透明度",
        "每图配一句话结论 + 可见数据表"
      ]
    }
  },
  "layout": {
    "breakpoints": { "sm": 640, "md": 768, "lg": 1024, "xl": 1280 },
    "density": "compact",
    "sidebar_width": 256,
    "topbar_height": 64,
    "content_padding": 24
  },
  "a11y": {
    "min_contrast_normal_text": 4.5,
    "focus_visible": "required",
    "keyboard": "required"
  },
  "invariants": [
    {
      "id": "INV-001",
      "type": "visual",
      "description": "KPI 卡同高，且每张含数字 + 标签 + 变化（vs 昨日）三要素"
    },
    {
      "id": "INV-002",
      "type": "visual",
      "description": "主趋势图占内容宽度 >=2/3；第二数据块为列表/表格而非同权重图表"
    },
    {
      "id": "INV-003",
      "type": "functional",
      "description": "未分配工单列表必须有空态：说明为什么空 + 至少一个出口入口（区分筛选无结果与真空）"
    },
    {
      "id": "INV-004",
      "type": "functional",
      "description": "mock 数量级真实：日工单量 200-900 区间（周末回落），禁止 99999/123456 类假数据特征"
    }
  ],
  "constraints": {
    "project": [
      "技术栈固定 React 18 + Tailwind 3，不引入图表库（14 点趋势用原生 SVG）",
      "不引入新字体文件（系统字体栈）",
      "组件内不写裸色值：颜色仅经 tailwind.config 语义 token 引用",
      "间距 4px 基线（Tailwind 默认刻度）"
    ],
    "pages": {
      "operations-overview": [
        "骨架：左侧栏 256px + 顶栏 64px",
        "accent 仅用于：图表主线 / 主按钮 / 当前导航项",
        "文本对比度全部 >=4.5:1；subtle 档 (#64748B) 仅用于白色或浅灰表面，不用于 canvas 底"
      ]
    }
  },
  "precedence": ["invariants", "a11y_hard", "project_constraints", "tokens", "style_preferences"],
  "provenance": {
    "created": "2026-11-17",
    "updated": "2026-11-17",
    "decisions": ".vismith/decisions.log.md"
  }
}
