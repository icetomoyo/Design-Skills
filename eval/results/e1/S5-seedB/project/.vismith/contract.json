{
  "version": 1,
  "meta": {
    "product_type": "saas-dashboard",
    "audience": "工单客服运营团队（坐席与管理员）",
    "scenarios": ["工单运营总览（Dashboard）", "坐席设置（Settings）"]
  },
  "brand": {
    "personality": ["克制", "可信赖", "效率导向"],
    "references": ["既有 ink 中性阶 + accent 蓝（tailwind.config）"]
  },
  "style": {
    "direction": "低饱和中性色 + 蓝色 accent 的紧凑运营后台；白卡片浮于浅灰页面",
    "do_not": ["新增调色板档位", "大面积渐变/玻璃拟态", "顺手重构或更换组件库"]
  },
  "tokens": {
    "colors": {
      "primary": "#2563EB",
      "primary_strong": "#1D4ED8",
      "text_on_primary": "#FFFFFF",
      "neutrals": ["#0F172A", "#475569"],
      "surface": "#FFFFFF",
      "bg": { "page": "#F8FAFC", "card": "#FFFFFF", "border_divider": "#F1F5F9" }
    },
    "typography": {
      "body": "Inter, system-ui, sans-serif",
      "display": "Inter, system-ui, sans-serif",
      "scale": [14, 16, 20, 24, 30]
    },
    "spacing": {
      "base": 4,
      "scale": [4, 8, 12, 16, 24, 32]
    },
    "radius": {
      "sm": 4,
      "md": 8,
      "lg": 12
    },
    "shadow": {
      "card": "0 1px 3px rgba(0,0,0,.08)"
    }
  },
  "components": {
    "metric_card": { "rules": ["标签用 ink-600，数值用 ink-900 或 accent-600", "圆角 md、内边距 16"] },
    "link_inline": { "rules": ["用 accent-600 文本色", "focus-visible 可见焦点"] }
  },
  "layout": {
    "breakpoints": {},
    "density": "compact"
  },
  "a11y": {
    "min_contrast_normal_text": 4.5,
    "focus_visible": "required",
    "keyboard": "required"
  },
  "invariants": [
    {
      "id": "INV-001",
      "type": "functional",
      "description": "Dashboard 指标数据与未分配工单列表逻辑不变（filter(!assignee).slice(0,8)、/tickets/:id 链接行为不变）"
    },
    {
      "id": "INV-002",
      "type": "functional",
      "description": "Settings 表单字段（显示名称/回复签名）与提交按钮行为不变"
    },
    {
      "id": "INV-003",
      "type": "visual",
      "description": "布局结构与信息架构不变：4 列指标卡 grid、列表分区、max-w 容器与页面骨架保持原样"
    },
    {
      "id": "INV-004",
      "type": "behavior",
      "description": "技术栈不变：React + Tailwind，不引入新依赖、不换组件库；ink/accent 既有色值不改动"
    }
  ],
  "constraints": {
    "project": ["最小 diff（refine 红线）", "不新增调色板颜色值", "间距只允许 4px 基线档位"],
    "pages": {
      "Dashboard": "指标卡数量与顺序不变；横幅图片保留",
      "Settings": "表单控件类型不变（input/textarea/button）"
    }
  },
  "precedence": [
    "invariants",
    "a11y_hard",
    "project_constraints",
    "tokens",
    "style_preferences"
  ],
  "provenance": {
    "created": "2026-11-17",
    "updated": "2026-11-17",
    "decisions": ".vismith/decisions.log.md",
    "note": "由 contract.mjs extract 草稿（colors 来自 tailwind.config.js）经人工确认转正；spacing 补齐 32、radius 补齐 lg（与 config 实际一致）"
  }
}
