{
  "version": 1,
  "meta": {
    "product_type": "marketing-site",
    "audience": "SQLite / 本地优先应用开发者",
    "scenarios": [
      "开发者工具产品落地页：hero + 三段功能论点 + 定价表 + 信任区 + 页脚"
    ]
  },
  "brand": {
    "personality": ["精确", "克制", "工程感"],
    "references": ["开发者文档式落地页：低饱和、结构化、证据先于形容词"]
  },
  "style": {
    "direction": "低饱和 ink 冷中性 ramp + 单一钴蓝 accent；文档式落地页：非对称两栏、安静留白、每个论点配可验证细节",
    "do_not": [
      "大面积渐变与玻璃拟态",
      "hero 上方 pill 徽章与悬浮 blob/orb 背景",
      "头像点阵、无来源五星评分、无来源用户数",
      "hype 文案（赋能/无缝/革命性/seamless 等）",
      "全部居中堆叠布局"
    ]
  },
  "tokens": {
    "colors": {
      "primary": "#0047AB",
      "primary_strong": "#003A87",
      "text_on_primary": "#FFFFFF",
      "neutrals": ["#101828", "#344054", "#475467", "#667085"],
      "surface": "#FFFFFF",
      "surface_alt": "#F6F8FB",
      "surface_dark": "#101828",
      "border": "#E3E8EF",
      "border_strong": "#C7D0DE",
      "text_on_dark": "#FFFFFF",
      "text_on_dark_muted": "#C7D0DE",
      "accent_on_dark": "#8FB3FF"
    },
    "typography": {
      "body": "Inter, system-ui, -apple-system, sans-serif",
      "display": "Inter, system-ui, -apple-system, sans-serif",
      "mono": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
      "scale": [12, 14, 16, 18, 20, 24, 32, 36, 40, 48, 56]
    },
    "spacing": {
      "base": 4,
      "scale": [4, 8, 12, 16, 20, 24, 32, 40, 48, 64, 80, 96, 112, 120, 128]
    },
    "radius": {
      "sm": 4,
      "md": 8,
      "lg": 12
    },
    "shadow": {
      "card": "0 1px 2px rgba(16,24,40,.06), 0 1px 3px rgba(16,24,40,.10)"
    }
  },
  "components": {
    "button": {
      "height": 40,
      "radius": "md",
      "rules": [
        "主操作唯一：全页仅一个实心 accent 按钮（hero 主 CTA）",
        "次级动作用描边按钮或文字链，不再使用实心 accent"
      ]
    },
    "code": {
      "radius": "lg",
      "rules": [
        "代码样例语法着色只允许引用 token 变量",
        "代码块必须可被键盘选中复制，不使用图片"
      ]
    }
  },
  "layout": {
    "breakpoints": {
      "sm": 640,
      "md": 768,
      "lg": 1024,
      "xl": 1280
    },
    "density": "comfortable"
  },
  "a11y": {
    "min_contrast_normal_text": 4.5,
    "focus_visible": "required",
    "keyboard": "required"
  },
  "invariants": [
    {
      "id": "INV-001",
      "type": "functional",
      "description": "顶部导航（产品标识 + 文档/API/定价/GitHub 链接）必须保留，任意视口不可隐藏不可折叠丢失"
    },
    {
      "id": "INV-002",
      "type": "functional",
      "description": "hero 区唯一主 CTA（实心钴蓝『快速开始』）必须保留，且全页至多一个次级动作（GitHub 描边链接）与之并列"
    },
    {
      "id": "INV-003",
      "type": "visual",
      "description": "章节分节间距保持 80-128px 节奏（落地页节间基线）"
    }
  ],
  "constraints": {
    "project": [
      "不引入构建步骤：纯静态 HTML/CSS，可直接在浏览器打开",
      "不引入 Inter 与等宽栈之外的字体族，不加载远程字体文件",
      "组件层（main.css/index.html）颜色一律引用 src/vars.css 的 token 变量，零硬编码色值"
    ],
    "pages": {
      "index.html": [
        "hero 两栏非对称：左侧文案（唯一主 CTA + 唯一次级动作），右侧真实 API 代码样例",
        "定价区位于首屏以下，白/浅底上的文字对比度 >= 4.5:1",
        "信任区仅含可验证要素：开源仓库、License、版本号、文档链接；无头像点阵与五星",
        "三段功能论点每段一个论点 + 可验证细节（协议参数/数据格式），交替左右对齐"
      ]
    }
  },
  "precedence": [
    "invariants",
    "a11y_hard",
    "project_constraints",
    "tokens",
    "style_preferences"
  ],
  "provenance": {
    "created": "2026-11-17",
    "updated": "2026-11-17",
    "decisions": ".vismith/decisions.log.md",
    "note": "由 S3 落地页任务 init 后按 brief 修订：ink 中性 ramp + 钴蓝 accent + Inter 正文"
  }
}
