{
  "version": 1,
  "meta": {
    "product_type": "saas-dashboard",
    "audience": "工单系统的坐席与运营人员（内部工具，intent=operate）",
    "scenarios": ["工单运营总览（指标卡+未分配列表）", "坐席设置（表单）"]
  },
  "brand": {
    "personality": ["高效", "克制", "可信"],
    "references": []
  },
  "style": {
    "direction": "数据密集运营台现状：白卡片 + ink 中性文本 + accent 蓝主色，紧凑间距，无装饰（refine 仅修用法不改体系）",
    "do_not": ["大面积渐变", "玻璃拟态", "引入新装饰风格"]
  },
  "tokens": {
    "colors": {
      "primary": "#2563EB",
      "primary_strong": "#1D4ED8",
      "neutrals": ["#0F172A", "#475569"],
      "surface": "#FFFFFF",
      "surface_alt": "#F8FAFC",
      "border": "#F1F5F9",
      "text_on_primary": "#FFFFFF"
    },
    "typography": {
      "body": "Inter, system-ui, sans-serif",
      "display": "Inter, system-ui, sans-serif",
      "scale": [14, 16, 18, 20, 24, 30]
    },
    "spacing": {
      "base": 4,
      "scale": [4, 8, 12, 16, 24, 32]
    },
    "radius": {
      "sm": 4,
      "md": 8,
      "lg": 12
    },
    "shadow": {
      "card": "0 1px 3px rgba(0,0,0,.08)"
    }
  },
  "components": {
    "stat_card": {
      "rules": ["标签用次要文本色 ink-600", "数值用 ink-900"]
    },
    "link_action": {
      "rules": ["行动链接用 accent token，可见焦点环"]
    }
  },
  "layout": {
    "breakpoints": {},
    "density": "compact"
  },
  "a11y": {
    "min_contrast_normal_text": 4.5,
    "focus_visible": "required",
    "keyboard": "required"
  },
  "invariants": [
    {
      "id": "INV-001",
      "type": "functional",
      "description": "未分配工单列表逻辑不变：渲染 tickets 中无 assignee 的前 8 条，每条保留指向 /tickets/<id> 的处理链接与跳转能力"
    },
    {
      "id": "INV-002",
      "type": "visual",
      "description": "布局结构不变：总览页 4 列指标卡网格 + 未分配工单列表 + 底部 banner 图；设置页表单字段（显示名称/回复签名）与保存按钮及顺序不变；accent 蓝 + ink 中性的配色体系不变"
    },
    {
      "id": "INV-003",
      "type": "behavior",
      "description": "设置表单 label/input 关联（htmlFor/id）与受控初始值行为不变；技术栈不变（React + Tailwind，不引入新依赖）"
    }
  ],
  "constraints": {
    "project": [
      "不改技术栈、不换组件库、不引入新依赖",
      "不改布局结构与信息架构",
      "refine 最小 diff：只修 a11y 确定性错误与 token 偏离"
    ],
    "pages": {}
  },
  "precedence": [
    "invariants",
    "a11y_hard",
    "project_constraints",
    "tokens",
    "style_preferences"
  ],
  "provenance": {
    "created": "2026-11-17",
    "updated": "2026-11-17",
    "decisions": ".vismith/decisions.log.md",
    "note": "由 contract.mjs extract 草稿人工转正：颜色/间距/圆角以 tailwind.config.js 为真值源修正（extract 启发式丢失嵌套与部分档位）"
  }
}
