{
  "contractVersion": "1.0-draft",
  "source": "extract 阶段：自既有实现（tailwind.config.js + src/pages/*）提取的契约草稿",
  "mode": "operate",
  "surfaces": ["Dashboard · 工单运营总览", "Settings · 坐席设置"],
  "tokens": {
    "color": {
      "ink": { "50": "#F8FAFC", "100": "#F1F5F9", "600": "#475569", "900": "#0F172A" },
      "accent": { "500": "#2563EB", "600": "#1D4ED8" },
      "status": { "warn": "#C2410C" }
    },
    "spacing": { "baseline": "4px", "scale": [4, 8, 12, 16, 24, 32] },
    "radius": { "sm": "4px", "md": "8px", "lg": "12px" },
    "font": { "sans": ["Inter", "system-ui", "sans-serif"] }
  },
  "semanticUsage": [
    { "role": "页面背景", "class": "bg-ink-50", "hex": "#F8FAFC" },
    { "role": "卡片表面", "value": "#FFFFFF" },
    { "role": "主文本（标题/数值）", "class": "text-ink-900", "on": "#FFFFFF", "min": 4.5 },
    { "role": "次级文本/统计标签", "class": "text-ink-600", "on": "#FFFFFF", "min": 4.5 },
    { "role": "次级文本/表单标签", "class": "text-ink-600", "on": "#F8FAFC", "min": 4.5 },
    { "role": "动作链接", "class": "text-accent-600", "on": "#FFFFFF", "min": 4.5 },
    { "role": "告警指标（大号 semibold）", "class": "text-status-warn", "on": "#FFFFFF", "min": 3.0 },
    { "role": "主按钮", "class": "bg-accent-500/text-white", "on": "#2563EB", "min": 4.5 }
  ],
  "rules": [
    { "id": "CHK-01", "rule": "文本对比度：正文 >=4.5:1，大文本（>=24px 或 >=18.66px 粗体）>=3:1（WCAG 1.4.3 AA）" },
    { "id": "CHK-02", "rule": "页面组件中禁止裸十六进制色；一切颜色经 tailwind.config.js 令牌表达" },
    { "id": "CHK-06", "rule": "间距只取 4px 基线刻度（4/8/12/16/24/32）；禁止脱离刻度的内联 margin/padding 像素值" },
    { "id": "CHK-IMG", "rule": "每个 <img> 必须携带非空、描述性 alt（中文）" }
  ],
  "invariants": [
    "页面结构不变：Dashboard = 页头 + 4 格指标栅格 + 未分配工单列表 + 底部横幅；Settings = 表单",
    "文案、数据展示、交互目标（/tickets/:id 链接、表单字段）不变",
    "不重构、不引入/更换组件库、不改布局结构与栅格",
    "SLA 指标保留暖色强调信号；「处理」链接保留彩色可辨识的动作外观",
    "中文界面语言与既有视觉基调保持"
  ],
  "deferred": [
    {
      "item": "输入框 border-ink-100 于白色表面 ≈1.07:1，触及 WCAG 1.4.11 非文本对比度 3:1",
      "severity": "P3",
      "reason": "属非文本边界议题、超出本次文本对比度修复范围；加深边框的视觉代价大于本次『最小 diff、不改产品特征』目标，记录待产品确认"
    }
  ]
}
