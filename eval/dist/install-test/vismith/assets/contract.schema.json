{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vismith Design Contract",
  "type": "object",
  "required": [
    "version",
    "meta",
    "style",
    "tokens",
    "a11y",
    "precedence"
  ],
  "properties": {
    "version": {
      "type": "number",
      "enum": [
        1
      ]
    },
    "meta": {
      "type": "object",
      "required": [
        "product_type"
      ],
      "properties": {
        "product_type": {
          "enum": [
            "saas-dashboard",
            "admin-console",
            "marketing-site",
            "consumer-app",
            "creative",
            "data-intensive"
          ]
        },
        "audience": {
          "type": "string"
        },
        "scenarios": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "brand": {
      "type": "object",
      "properties": {
        "personality": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "references": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "style": {
      "type": "object",
      "required": [
        "direction"
      ],
      "properties": {
        "direction": {
          "type": "string"
        },
        "do_not": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "tokens": {
      "type": "object",
      "properties": {
        "colors": {
          "type": "object"
        },
        "typography": {
          "type": "object",
          "properties": {
            "body": {
              "type": "string"
            },
            "display": {
              "type": "string"
            },
            "scale": {
              "type": "array",
              "items": {
                "type": "number"
              }
            }
          }
        },
        "spacing": {
          "type": "object",
          "properties": {
            "base": {
              "type": "number"
            },
            "scale": {
              "type": "array",
              "items": {
                "type": "number"
              }
            }
          }
        },
        "radius": {
          "type": "object"
        },
        "shadow": {
          "type": "object"
        }
      }
    },
    "components": {
      "type": "object"
    },
    "layout": {
      "type": "object",
      "properties": {
        "breakpoints": {
          "type": "object"
        },
        "density": {
          "type": "string"
        }
      }
    },
    "a11y": {
      "type": "object",
      "required": [
        "min_contrast_normal_text"
      ],
      "properties": {
        "min_contrast_normal_text": {
          "type": "number"
        },
        "focus_visible": {
          "enum": [
            "required",
            "optional"
          ]
        },
        "keyboard": {
          "enum": [
            "required",
            "optional"
          ]
        }
      }
    },
    "invariants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "enum": [
              "functional",
              "behavior",
              "visual"
            ]
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "constraints": {
      "type": "object",
      "properties": {
        "project": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pages": {
          "type": "object"
        }
      }
    },
    "precedence": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 5
    },
    "provenance": {
      "type": "object",
      "properties": {
        "created": {
          "type": "string"
        },
        "updated": {
          "type": "string"
        },
        "decisions": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      }
    }
  }
}
